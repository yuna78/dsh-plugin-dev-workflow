{
  "name": "dsh-plugin-dev-workflow",
  "version": "0.2.6",
  "private": false,
  "description": "Lightweight dev workflow for DSH: a dev-assistant preset, a read-only kanban, and decisions that stay in the repo",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "dev-workflow", "lightweight", "preset", "kanban", "feedback", "task-management"],
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "peerDependencies": { "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0" },
  "type": "module",
  "main": "./index.js",
  "homepage": "https://github.com/yuna78/dsh-plugin-dev-workflow#readme",
  "repository": { "type": "git", "url": "git+https://github.com/yuna78/dsh-plugin-dev-workflow.git" },
  "bugs": { "url": "https://github.com/yuna78/dsh-plugin-dev-workflow/issues" },
  "icon": "assets/icon.svg",
  "scripts": { "test": "node verify/smoke.mjs && node verify/status.mjs && node verify/context-status.mjs", "preview": "node verify/preview.mjs", "prepublishOnly": "npm test" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE", "assets/icon.svg", "assets/workflow-infographic.svg"]
}
